# IDLE 1 v1.1 backend configuration (example, no secrets)
MONGO_URL="mongodb://localhost:27017"
DB_NAME="idle1_v11"
# preview | production. In production TEST_HOOKS_ENABLED must be false.
IDLE1_ENV="production"
# openssl rand -hex 32
JWT_SECRET="<64-hex-random>"
JWT_ISSUER="idle1-api"
JWT_AUDIENCE="idle1-mobile"
ACCESS_TOKEN_MINUTES="15"
REFRESH_TOKEN_DAYS="30"
# comma-separated allowlist for web preview origins (mobile apps send no Origin)
CORS_ORIGINS="https://your-web-preview.example.com"
# Emergent managed transactional email (provisioned by platform)
EMERGENT_EMAIL_KEY="<provisioned>"
EMAIL_FROM_NAME="IDLE 1"
# Emergent managed push (replaced automatically at deployment)
EMERGENT_PUSH_KEY="placeholder"
# RevenueCat (owner deployment inputs)
REVENUECAT_SECRET_KEY=""
REVENUECAT_WEBHOOK_TOKEN="<long-random>"
# Optional HMAC hardening for the RevenueCat webhook. When empty the signature
# check is skipped and only REVENUECAT_WEBHOOK_TOKEN protects the endpoint.
REVENUECAT_WEBHOOK_SIGNING_SECRET=""
# Test-only hooks (/api/_test/*). MUST be false in production.
TEST_HOOKS_ENABLED="false"
# Disables SlowAPI limits for QA/load simulations only. Refused in production.
RATE_LIMIT_DISABLED="false"
MIN_AGE_GATE="13"
# Legal deployment inputs (owner-provided public URLs)
PRIVACY_POLICY_URL=""
TERMS_URL=""
